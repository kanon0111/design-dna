<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@400;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap">
<style>
  /* 編集室 — 生成りの紙、明朝の見出し、罫線だけで構造をつくる */
  :root{
    --bg:#f6f3ec; --card:#f6f3ec; --band:#efeade;
    --line:#1c1a17; --rule:#ddd6c8; --soft:#c8c0b0;
    --fg:#1c1a17; --muted:#857f74; --dim:#a09889;
    --pick:#a83a2a; --warn:#a83a2a;
    --slot1:#a83a2a; --slot2:#a83a2a; --slot3:#a83a2a;
    --mincho:'Zen Old Mincho','Yu Mincho',YuMincho,'Hiragino Mincho ProN',serif;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--fg);
    font-family:'Zen Kaku Gothic New','Hiragino Kaku Gothic ProN',Meiryo,sans-serif;
    font-weight:400;line-height:1.8}

  /* --- 見出し --- */
  header{position:sticky;top:0;z-index:20;background:var(--bg);border-bottom:1px solid var(--line);
    padding:30px 72px 22px;display:flex;align-items:baseline;gap:24px;flex-wrap:wrap}
  h1{font-family:var(--mincho);font-size:28px;margin:0;font-weight:700;
    letter-spacing:.02em;line-height:1.2;white-space:nowrap}
  .sub{font-size:12px;color:var(--muted)}
  .spacer{flex:1}
  button{font:inherit;font-size:13px;padding:6px 2px;border-radius:0;cursor:pointer;
    border:0;border-bottom:1px solid var(--soft);background:none;color:#5b5549}
  button:hover{border-bottom-color:var(--line);color:var(--line)}
  .status{font-size:12px;color:var(--muted);letter-spacing:.12em;min-width:160px;text-align:right}
  .status.ok{color:var(--fg)}
  .status.ng{color:var(--pick)}

  /* --- 3つの枠（ヘッダー版・現在は未使用） --- */
  .slots{display:flex;gap:14px;flex-wrap:wrap}
  .slot{display:flex;align-items:center;gap:10px;border:0;border-top:2px solid var(--line);
    border-radius:0;padding:12px 0 0;font-size:12px;background:none;width:214px}
  .slot .dot{display:none}
  .slot .body{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
  .slot .role{font-size:11px;letter-spacing:.18em;color:var(--muted);font-weight:400}
  .slot .val{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;color:var(--dim)}
  .slot.filled .val{font-family:var(--mincho);color:var(--fg);font-size:15px}
  .slot .x{flex:none;width:24px;height:24px;border-radius:0;border:1px solid var(--soft);
    background:none;color:var(--muted);font-size:13px;line-height:1;cursor:pointer;
    display:flex;align-items:center;justify-content:center;padding:0}
  .slot .x:hover{border-color:var(--pick);color:var(--pick)}
  .slot.ai{border-top-color:var(--pick)}

  /* 選んだもののサムネ */
  .pic{width:38px;height:50px;border-radius:0;overflow:hidden;flex:none;
    background:#fff;border:1px solid var(--rule);cursor:pointer;display:block}
  .pic img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
  .pic.empty{border:1px dashed var(--soft);cursor:default}

  main{max-width:1560px;margin:0 auto;padding:0 72px 80px}
  .lead{font-family:var(--mincho);font-size:17px;color:var(--fg);margin:32px 0 22px;line-height:1.8}
  .lead b{font-weight:700}

  /* --- 系統 --- */
  .cats{display:grid;gap:38px 30px;grid-template-columns:repeat(auto-fill,minmax(330px,1fr))}
  .cat{border:0;border-radius:0;background:none;overflow:visible;cursor:pointer;
    display:flex;flex-direction:column;gap:12px;transition:.15s}
  .cat:hover{opacity:.78}
  .cat .montage{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:var(--rule)}
  .cat .montage div{aspect-ratio:3/4;overflow:hidden;background:#fff}
  .cat .montage img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
  /* 見出しと件数は別セルなので、列間を0にしないと下の罫線が分断される */
  .cat .body{padding:0;display:grid;grid-template-columns:1fr auto;
    grid-template-areas:"t n" "d d";align-items:baseline;column-gap:0}
  .cat .title{grid-area:t;font-family:var(--mincho);font-size:21px;font-weight:700;margin:0;
    border-bottom:1px solid var(--line);padding:0 14px 9px 0}
  .cat .n{grid-area:n;font-family:var(--mincho);font-size:21px;font-weight:700;color:var(--pick);
    margin:0;border-bottom:1px solid var(--line);padding-bottom:9px}
  .cat .desc{grid-area:d;font-size:12px;color:var(--muted);line-height:1.7;
    letter-spacing:.04em;margin-top:9px}

  /* --- 一覧 --- */
  .crumb{display:flex;align-items:baseline;gap:16px;margin:30px 0 20px;flex-wrap:wrap;
    border-bottom:1px solid var(--line);padding-bottom:12px}
  .crumb .now{font-family:var(--mincho);font-size:22px;font-weight:700}
  .crumb .meta{font-size:12px;color:var(--muted);letter-spacing:.1em}
  .grid{display:grid;gap:30px 24px;grid-template-columns:repeat(auto-fill,minmax(250px,1fr))}
  .card{position:relative;border:0;border-radius:0;overflow:visible;background:none;
    cursor:pointer;transition:.12s}
  .card:hover{opacity:.78}
  .card.on,.card.on[data-role="色"],.card.on[data-role="文字"]{opacity:1}
  .card.on .thumb{outline:2px solid var(--line);outline-offset:4px}
  .thumb{aspect-ratio:3/4;background:#fff;overflow:hidden;display:block;
    border:1px solid var(--rule)}
  .thumb img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
  .meta{display:flex;align-items:baseline;gap:10px;padding:11px 0 0;font-size:13px;
    border-top:1px solid var(--line);margin-top:12px}
  .id{color:var(--dim);font-size:11px;letter-spacing:.1em}
  .name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
    font-family:var(--mincho);font-size:15px}
  .src{color:var(--dim);font-size:10px;text-transform:uppercase;letter-spacing:.14em}
  .badge{position:absolute;top:0;left:0;padding:4px 11px;border-radius:0;
    font-size:11px;letter-spacing:.1em;color:#f6f3ec;background:var(--pick);display:none}
  .card.on .badge,.card.on[data-role="色"] .badge,.card.on[data-role="文字"] .badge{
    display:block;background:var(--pick)}
  a.ext{position:absolute;top:0;right:0;background:var(--line);color:var(--bg);
    text-decoration:none;font-size:11px;padding:4px 10px;border-radius:0;opacity:0;transition:.15s}
  .card:hover a.ext,.card:hover .ext{opacity:1}
  .ext.zoom{position:absolute;top:0;right:0;background:var(--line);color:var(--bg);
    border:0;font-size:11px;letter-spacing:.1em;padding:5px 11px;border-radius:0;
    opacity:0;transition:.15s;cursor:pointer}
  .hidden{display:none}

  /* --- 自由度 --- */
  #panel{position:sticky;bottom:0;z-index:15;background:var(--band);border-top:1px solid var(--line);
    padding:24px 72px 28px;display:flex;gap:52px;align-items:flex-end;flex-wrap:wrap}
  #panel .col{display:flex;flex-direction:column;gap:9px}
  #panel .col.grow{flex:1;min-width:300px}
  #panel label{font-family:var(--mincho);font-size:15px;font-weight:700;
    display:flex;align-items:baseline;gap:12px}
  #panel .hint{font-size:11.5px;color:var(--muted);line-height:1.7}
  #panel .hint b{color:var(--fg);font-weight:700}
  input[type=range]{width:100%;accent-color:var(--pick);height:12px}
  .fnum{font-family:var(--mincho);font-size:40px;font-weight:700;line-height:1;letter-spacing:-.01em}
  .axes{display:flex;gap:7px;flex-wrap:wrap;margin-top:4px}
  .ax{font-size:12px;padding:4px 11px;border-radius:0;border:1px solid var(--soft);color:var(--dim)}
  .ax.free{background:var(--line);border-color:var(--line);color:var(--bg)}
  select{font:inherit;font-family:var(--mincho);font-size:18px;padding:6px 2px;border-radius:0;
    border:0;border-bottom:1px solid var(--line);background:none;color:var(--fg)}
  button.go{background:var(--line);border:0;color:var(--bg);font-weight:500;
    font-size:16px;padding:17px 46px;letter-spacing:.04em}
  button.go:hover{background:var(--pick)}
  button.go:disabled{opacity:.35;cursor:not-allowed}
  #reqmsg{font-size:12px;color:var(--muted);margin-top:8px}
  #reqmsg.ok{color:var(--fg)}

  /* --- おまかせ --- */
  #ai{max-width:1560px;margin:0 auto;border:0;border-bottom:1px solid var(--rule);
    background:none;padding:0 0 30px}
  #ai .cap{font-family:var(--mincho);font-size:17px;color:var(--fg);line-height:1.8;
    padding:30px 0 14px}
  #ai .cap b{font-weight:700}
  #ai .row{display:flex;gap:32px;align-items:flex-end;flex-wrap:wrap}
  #ai textarea{flex:1;min-width:300px;min-height:52px;resize:vertical;font:inherit;font-size:16px;
    padding:0 0 11px;border-radius:0;border:0;border-bottom:1px solid var(--line);
    background:none;color:var(--fg);line-height:1.7}
  #ai textarea::placeholder{color:var(--dim)}
  button.ask{background:var(--line);border:0;color:var(--bg);font-weight:500;
    font-size:15px;padding:15px 26px;white-space:nowrap}
  button.ask:hover{background:var(--pick)}
  #aimsg{font-size:12.5px;color:var(--muted);margin-top:12px}
  #aimsg.ok{color:var(--fg)}

  /* --- 選択中 --- */
  #proposal{display:none;margin-top:34px;border:0;padding-top:0}
  #proposal.on{display:block}
  #proposal h3{font-family:var(--mincho);font-size:20px;margin:0 0 22px;font-weight:700;
    display:flex;align-items:center;gap:14px}
  .pcards{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:30px;
    margin-bottom:28px;border:0}
  .pcard{position:relative;border:0;border-top:2px solid var(--line);border-radius:0;
    background:none;display:flex;gap:18px;padding:16px 0 0}
  .pcard .pic{width:104px;height:138px;border-radius:0;border:1px solid var(--rule)}
  .pcard .txt{min-width:0;display:flex;flex-direction:column;gap:5px}
  .pcard .r{font-size:11px;letter-spacing:.18em;color:var(--muted)}
  .pcard .n{font-family:var(--mincho);font-size:19px;font-weight:700;line-height:1.3;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .pcard .why{font-size:12.5px;color:#6b655a;line-height:1.7;text-wrap:pretty}
  .pcard .x{position:absolute;top:16px;right:0;width:24px;height:24px;border-radius:0;
    border:1px solid var(--soft);background:none;color:var(--muted);font-size:13px;
    line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0}
  .pcard .x:hover{border-color:var(--pick);color:var(--pick)}
  .pcard.empty{border-top:1px dashed var(--soft);cursor:pointer;align-items:flex-start}
  .pcard.empty .pic{border:1px dashed var(--soft)}
  .pcard.empty:hover{opacity:.72}
  .pcard .dim{color:var(--dim)}
  .pcard .acts{display:flex;gap:14px;margin-top:6px}
  .pcard .acts a,.pcard .acts button{font-size:12px;padding:0 0 1px;border-radius:0;
    border:0;border-bottom:1px solid var(--soft);background:none;color:#5b5549;
    text-decoration:none;cursor:pointer}
  .pcard .acts a:hover,.pcard .acts button:hover{border-bottom-color:var(--line);color:var(--line)}
  #paccept{display:flex;gap:14px}
  #paccept .go{background:var(--pick);font-size:14.5px;padding:13px 30px}
  #paccept .go:hover{background:var(--line)}
  #paccept button:not(.go){border:1px solid var(--soft);border-bottom-width:1px;
    padding:13px 26px;font-size:14.5px;color:#5b5549}
  #paccept button:not(.go):hover{border-color:var(--line);background:none}
  .aitag{font-size:11px;letter-spacing:.16em;color:var(--pick);
    border:1px solid var(--pick);border-radius:0;padding:3px 9px}

  /* --- 拡大表示 --- */
  #lb{position:fixed;inset:0;z-index:100;background:rgba(28,26,23,.92);display:none;
    align-items:center;justify-content:center;padding:28px;cursor:zoom-out}
  #lb.on{display:flex}
  #lb figure{margin:0;max-width:100%;max-height:100%;display:flex;flex-direction:column;gap:12px}
  #lb img{max-width:100%;max-height:calc(100vh - 110px);object-fit:contain;
    border-radius:0;background:#fff;display:block;margin:0 auto}
  #lb figcaption{font-family:var(--mincho);color:#f6f3ec;font-size:15px;text-align:center;
    display:flex;gap:18px;justify-content:center;align-items:center}
  #lb figcaption a{color:#f6f3ec}
  #lb figcaption span:last-child{font-family:'Zen Kaku Gothic New',sans-serif;
    font-size:12px;color:#a8a196}
</style>
